<?xml version="1.0" encoding="utf-8"?>
<!-- 2x1 picker entry: today's risk percent, band label and ovulation caption.
     Fixed size, not resizable. updatePeriodMillis repaints once a day so the
     figures advance even when the app is never opened. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="86400000"
    android:initialLayout="@layout/widget_risk"
    android:previewLayout="@layout/widget_risk"
    android:resizeMode="none"
    android:widgetCategory="home_screen"
    android:description="@string/widget_risk_description" />
