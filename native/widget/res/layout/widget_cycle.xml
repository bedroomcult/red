<?xml version="1.0" encoding="utf-8"?>
<!-- Small 2x2 layout: the countdown and the phase name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/widget_days"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="40sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:textColor="@color/widget_ink"
        android:text="–" />

    <TextView
        android:id="@+id/widget_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:layout_marginTop="2dp"
        android:textColor="@color/widget_muted"
        android:text="Tandai haid untuk mulai" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <ImageView
            android:id="@+id/widget_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/widget_dot"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_phase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/widget_muted"
            android:text="Belum ada data" />
    </LinearLayout>

    <!-- Today's chance row. One of the three icons is shown, chosen by the
         same band the app computes; the label names the band, never safety. -->
    <LinearLayout
        android:id="@+id/widget_chance_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <ImageView
            android:id="@+id/widget_chance_high"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/widget_chance_high"
            android:visibility="gone"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/widget_chance_medium"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/widget_chance_medium"
            android:visibility="gone"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/widget_chance_low"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/widget_chance_low"
            android:visibility="gone"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_chance_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/widget_muted"
            android:text="@string/risk_unknown" />
    </LinearLayout>
</LinearLayout>
