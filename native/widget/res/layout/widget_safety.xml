<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1 entry: a band-coloured droplet with a white percent centred on it.
     No band label: the colour alone carries the signal. RemoteViews cannot
     tint a TextView background alone, so a FrameLayout stacks a tinted
     droplet ImageView behind a white percent TextView. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="6dp"
    android:background="@drawable/widget_bg">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp">

        <ImageView
            android:id="@+id/widget_drop_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_drop_bg"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_chance_label"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="13sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:textColor="#FFFFFFFF"
            android:text="–" />
    </FrameLayout>
</LinearLayout>
