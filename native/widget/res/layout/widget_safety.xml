<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1 entry: a centred 48dp SQUARE, sized for the smallest launcher
     cell so nothing clips. Saturated app palette per band, big percent
     plus a small band label, both centred. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_ground"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:src="@drawable/widget_safety_bg"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/widget_chance_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:textColor="@color/widget_ink"
            android:text="–" />

        <TextView
            android:id="@+id/widget_safety_band"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/widget_ink"
            android:text="@string/risk_unknown" />
    </LinearLayout>
</FrameLayout>
