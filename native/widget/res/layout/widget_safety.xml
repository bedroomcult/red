<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1 entry: legibility first. Band-tinted ground, big black percent,
     small band label beneath it. No droplet: at 1x1 the shape cost more
     space than it added signal. A FrameLayout stacks the tinted ground
     behind centred text, since RemoteViews cannot tint a layout. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_ground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_safety_bg"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="6dp">

        <TextView
            android:id="@+id/widget_chance_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:textColor="@color/widget_ink"
            android:text="–" />

        <TextView
            android:id="@+id/widget_safety_band"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/widget_muted"
            android:text="@string/risk_unknown" />
    </LinearLayout>
</FrameLayout>
