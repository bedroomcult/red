<?xml version="1.0" encoding="utf-8"?>
<!-- 2x1 entry: percent plus band plus ovulation caption. Icons reused from safety entry. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:id="@+id/widget_risk_icon_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_chance_high"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/widget_chance_high"
            android:visibility="gone"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/widget_chance_medium"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/widget_chance_medium"
            android:visibility="gone"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/widget_chance_low"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/widget_chance_low"
            android:visibility="gone"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/widget_risk_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:textColor="@color/widget_ink"
            android:text="–" />

        <TextView
            android:id="@+id/widget_risk_band"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_muted"
            android:text="@string/risk_unknown" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/widget_risk_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/widget_muted"
            android:text="@string/risk_unknown" />

        <TextView
            android:id="@+id/widget_risk_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="10sp"
            android:textColor="@color/widget_muted"
            android:text="@string/widget_risk_note" />
    </LinearLayout>
</LinearLayout>
